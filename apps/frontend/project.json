{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project frontend --web",
  "targets": {
    "dev": {
      "command": "next dev --port 3001",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "command": "next dev --port 3001",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "start": {
      "command": "next start --port 3001",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
